{
  "expo": {
    "name": "Yasakia",
    "slug": "yasakia",
    "owner": "oussamaabid",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "yasakia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.krizaka.yasakia",
      "associatedDomains": ["applinks:dev.yasakia.com"],
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.krizaka.yasakia",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "dev.yasakia.com", "pathPrefix": "/app/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": { "bundler": "metro" },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": true }
  }
}
