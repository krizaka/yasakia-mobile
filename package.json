{
  "name": "yasakia-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "description": "Yasakia for iOS and Android \u2014 talk to your agent first, then a small batch of people who fit both ways. React Native (Expo).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/yasakia-mobile.git"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint && krizaka-i18n check src/messages && node scripts/check-app-links.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "export": "expo export --platform ios --platform android --output-dir dist",
    "check": "npm run lint && npm run typecheck && npm test && npm run export"
  },
  "dependencies": {
    "@krizaka/app-config": "^0.1.0",
    "@krizaka/i18n": "^0.2.2",
    "@krizaka/icons": "^0.5.1",
    "@krizaka/query": "^0.2.1",
    "@krizaka/tokens": "^3.27.0",
    "@krizaka/ui": "^3.27.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^30.5.2",
    "jest-expo": "^57.0.5",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "decode-uri-component": "^0.5.0",
    "uuid": "^11.1.1"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|react-navigation|@react-navigation|@krizaka|@tanstack))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@krizaka/([a-z0-9-]+)$": "<rootDir>/node_modules/@krizaka/$1/dist/index.js",
      "^@krizaka/([a-z0-9-]+)/([a-z0-9-]+)$": "<rootDir>/node_modules/@krizaka/$1/dist/$2.js"
    }
  }
}
